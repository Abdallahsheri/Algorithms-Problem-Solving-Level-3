//Problem #27 Invert Character Case.

char ReadChar()
{
    char ch1;
    cout << "Please enter a Character : " << endl;
    cin >> ch1;
    return ch1;
}

char InvertedLetterCase(char ch1)
{
    return isupper(ch1) ? tolower(ch1) : toupper(ch1);
}

int main() {
   
    char ch1 = ReadChar();
    
    cout << "Character after inverting the Case : " << endl;
    cout << InvertedLetterCase(ch1) << endl;

    system("pause>0");
}
