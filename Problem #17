//Problem #17 Check A Number Exist In Matrix

void PrintMatrix(int arr[3][3], short Rows, short Cols)
{
    for (short i = 0; i < Rows; i++)
    {
        for (short j = 0; j < Cols; j++)
        {
            cout << setw(3) << arr[i][j] << "   ";
        }
        cout << endl << endl;
    }
}

bool IsNumberInMatrix(int Matrix1[3][3], short Rows, short Cols, int Number)
{
    short CountNumber = 0;

    for (short i = 0; i < Rows; i++)
    {
        for (short j = 0; j < Cols; j++)
        {
            if (Matrix1[i][j] == Number)
            {
                return true;
            }
        }
    }
    return false;
}

int main() {
 
   int Matrix1[3][3] = { {77,5,12},{22,20,1},{1,0,9} };
   
   cout << "Matrix 1 : " << endl;
   PrintMatrix(Matrix1,3,3);

   int Number;
   cout << "\nPlease Enter the number to look for in matrix? ";
   cin >> Number;
   if (IsNumberInMatrix(Matrix1,3,3, Number))
   {
       cout << "Yes, It Is There";
   }
