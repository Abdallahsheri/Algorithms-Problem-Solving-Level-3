//Problem #15 Count Number In Matrix

void PrintMatrix(int arr[3][3], short Rows, short Cols)
{
    for (int i = 0; i < Rows; i++)
    {
        for (int j = 0; j < Cols; j++)
        {
            cout << setw(3) << arr[i][j] << "   ";
        }
        cout << endl << endl;
    }
}

short CountNumberInMatrix(int Matrix1[3][3], short Rows, short Cols, int Number)
{
    short NumberCount = 0;

    for (int i = 0; i < Rows; i++)
    {
        for (int j = 0; j < Cols; j++)
        {
            if (Matrix1[i][j] == Number)
            {
                NumberCount++;
            }
        }
    }
    return NumberCount;
}

int main() {
 
    srand((unsigned)time(NULL));
    
    int Matrix1[3][3] = { {9,1,12},{0,9,1},{0,9,9} };

    cout << "Matrix 1 : " << endl;
    PrintMatrix(Matrix1,3,3);

    int Number;
    cout << "Enter the Number to count in the Matrix : " << endl;
    cin >> Number;

    cout << "Number : " << Number << "Count In The Matrix Is : " << CountNumberInMatrix(Matrix1,3,3, Number);

    system("pause>0");
}
