//Problem #28 Invert All Letters Case.

string ReadString()
{
    string S1;
    cout << "Please Enter Your String : " << endl;
    getline(cin, S1);
    return S1;

}

char InvertedLetterCase(char ch1)
{
    return isupper(ch1) ? tolower(ch1) : toupper(ch1);
}

string InvertAllString(string S1)
{
    for (short i = 0; i < S1.length(); i++)
    {
        S1[i] = InvertedLetterCase(S1[i]);
    }
    return S1;
}

int main() {
   
    string S1 = ReadString();
    cout << "The String After Inverting All Letters Case : " << endl;
    cout << InvertAllString(S1) << endl;

    system("pause>0");
}
